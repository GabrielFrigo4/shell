#!/usr/bin/env sh
# ----------------------------------------------------------------
# Wrapper: GNU Emacs Client with Auto-Recovery & Theme Guard
# ----------------------------------------------------------------
set -eu

### ================================
### ENVIRONMENT RESOLUTION
### ================================
if ! command -v emacsclient > "/dev/null" 2>&1; then
	if [ -x "/usr/local/bin/emacsclient" ]; then
		PATH="/usr/local/bin:${PATH}"
	elif [ -x "/usr/bin/emacsclient" ]; then
		PATH="/usr/bin:${PATH}"
	fi
fi

if ! command -v emacsclient > "/dev/null" 2>&1; then
	printf '%s\n' "emacsclient: command not found" >&2
	exit 127
fi

### ================================
### THEME ISOLATION
### ================================
export GTK_THEME="Emacs-Doom-Dark"
export GTK_APPLICATION_PREFER_DARK_THEME=1

### ================================
### DAEMON HEALTHCHECK & AUTO-HEAL
### ================================
_emacs_uid="$(id -u 2> "/dev/null" || echo 1000)"
_emacs_sock_dir="${XDG_RUNTIME_DIR:-/tmp}/emacs${_emacs_uid}"
if [ -n "${EMACS_SOCKET_NAME:-}" ]; then
	case "${EMACS_SOCKET_NAME}" in
		*/*) _emacs_socket="${EMACS_SOCKET_NAME}" ;;
		*)   _emacs_socket="${_emacs_sock_dir}/${EMACS_SOCKET_NAME}" ;;
	esac
else
	_emacs_socket="${_emacs_sock_dir}/server"
fi

_has_daemon=0
if command -v pgrep > "/dev/null" 2>&1 && pgrep -f "emacs.*--.*daemon" > "/dev/null" 2>&1; then
	_has_daemon=1
fi

if [ "${_has_daemon}" -eq 1 ] || [ -S "${_emacs_socket}" ] || [ -e "${_emacs_socket}" ]; then
	_probe_ok=0
	if command -v timeout > "/dev/null" 2>&1; then
		timeout 2 emacsclient -e '(+ 1 1)' > "/dev/null" 2>&1 && _probe_ok=1 || _probe_ok=0
	else
		(
			emacsclient -e '(+ 1 1)' > "/dev/null" 2>&1 &
			_probe_pid=$!
			(
				sleep 2 2> "/dev/null" || true
				kill -0 "${_probe_pid}" 2> "/dev/null" && kill -9 "${_probe_pid}" 2> "/dev/null" || true
			) &
			_wd_pid=$!
			wait "${_probe_pid}" 2> "/dev/null"
			_probe_ret=$?
			kill -9 "${_wd_pid}" 2> "/dev/null" || true
			wait "${_wd_pid}" 2> "/dev/null" || true
			exit "${_probe_ret}"
		) && _probe_ok=1 || _probe_ok=0
	fi
	if [ "${_probe_ok}" -eq 0 ]; then
		if [ "${_has_daemon}" -eq 1 ]; then
			if command -v pkill > "/dev/null" 2>&1; then
				pkill -9 -f "emacs.*--.*daemon" > "/dev/null" 2>&1 || true
			else
				for _daemon_pid in $(pgrep -f "emacs.*--.*daemon" 2> "/dev/null" || true); do
					[ "${_daemon_pid}" != "$$" ] && kill -9 "${_daemon_pid}" 2> "/dev/null" || true
				done
				unset _daemon_pid
			fi
			sleep 0.5 2> "/dev/null" || sleep 1 2> "/dev/null" || true
		fi
		[ -e "${_emacs_socket}" ] && rm -f "${_emacs_socket}" 2> "/dev/null" || true
	fi
	unset _probe_ok
fi
unset _emacs_uid _emacs_sock_dir _emacs_socket _has_daemon

### ================================
### CLIENT EXECUTION
### ================================
if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
	if [ "$#" -eq 0 ]; then
		exec emacsclient --create-frame --alternate-editor="" -n
	else
		exec emacsclient --create-frame --alternate-editor="" "$@"
	fi
else
	exec emacsclient -t --alternate-editor="" "$@"
fi
