#!/usr/bin/env sh

### ================================
### PRE-COMMIT HOOK
### ================================

set -e

### --------------------------------
### Setup & Repository Root
### --------------------------------
_repo_root="$(git rev-parse --show-toplevel 2> "/dev/null" || pwd)"
cd "${_repo_root}"

echo "🔍 [pre-commit] Executing Universal Shell quality gates..."

### --------------------------------
### Whitespace & Formatting Check
### --------------------------------
echo "  ↳ Checking whitespace and formatting (git diff --check)..."
if ! git diff --check --cached; then
	echo "❌ [pre-commit] Whitespace or EOF formatting error detected!" >&2
	echo "   Run 'git diff --check --cached' to inspect issues." >&2
	exit 1
fi

### --------------------------------
### Bash & Shared Shell Syntax Check
### --------------------------------
echo "  ↳ Validating Bash & Shared Shell syntax (bash -n)..."
if ! find . -name "*.sh" -not -path "./.git/*" -not -path "*/zsh/*" -not -name "zsh.sh" -exec bash -n {} +; then
	echo "❌ [pre-commit] Syntax error detected by 'bash -n'!" >&2
	exit 1
fi

### --------------------------------
### Zsh Syntax Check
### --------------------------------
if command -v zsh > "/dev/null" 2>&1; then
	echo "  ↳ Validating Zsh syntax (zsh -n)..."
	if ! find . -name "*.sh" -not -path "./.git/*" -not -path "*/bash/*" -not -name "bash.sh" -exec zsh -n {} +; then
		echo "❌ [pre-commit] Syntax error detected by 'zsh -n'!" >&2
		exit 1
	fi
fi

### --------------------------------
### Quoting & Security Rules
### --------------------------------
echo "  ↳ Enforcing quoted redirects (> \"/dev/null\")..."
_unquoted_null=$(git diff --cached -S "> /dev/null" --name-only | grep '\.sh$' 2> "/dev/null" || true)
if [ -n "${_unquoted_null}" ]; then
	echo "❌ [pre-commit] Unquoted redirect '> /dev/null' detected in: ${_unquoted_null}" >&2
	echo "   Use '> \"/dev/null\"' with quotes as required by PRINCIPLES.md." >&2
	exit 1
fi

### --------------------------------
### Banner Geometry & Length Check
### --------------------------------
if command -v python3 > "/dev/null" 2>&1; then
	_staged_sh=$(git diff --cached --name-only --diff-filter=d | grep '\.sh$' 2> "/dev/null" || true)
	if [ -n "${_staged_sh}" ]; then
		echo "  ↳ Validating banner geometry (32/64 cols)..."
		python3 -c '
import sys, re
failed = False
for f in sys.argv[1:]:
    with open(f, "r", encoding="utf-8", errors="ignore") as fp:
        lines = [l.rstrip("\r\n") for l in fp]
    for idx, line in enumerate(lines, 1):
        m_sec = re.match(r"^###\s+(=+|-+)$", line)
        if m_sec and len(m_sec.group(1)) != 32:
            print(f"❌ {f}:L{idx}: Régua de seção possui {len(m_sec.group(1))} caracteres (esperado 32)")
            failed = True
        prev_line = lines[idx - 2] if idx >= 2 else ""
        next_line = lines[idx] if idx < len(lines) else ""
        if (re.match(r"^###\s+(=|-){32}$", prev_line) or re.match(r"^###\s+(=|-){32}$", next_line)) and line.startswith("### "):
            title = line[4:]
            if len(title) > 32:
                print(f"❌ {f}:L{idx}: Título vazou 32 colunas ({len(title)} cols): {title}")
                failed = True
            if re.search(r"[\(\)\[\]]", title):
                print(f"❌ {f}:L{idx}: Título contém parênteses/colchetes: {title}")
                failed = True
        if idx <= 6:
            m_hdr = re.match(r"^#\s+(-+)$", line)
            if m_hdr and len(m_hdr.group(1)) >= 20 and len(m_hdr.group(1)) != 64:
                print(f"❌ {f}:L{idx}: Régua de cabeçalho possui {len(m_hdr.group(1))} hífens (esperado 64)")
                failed = True
            if (re.match(r"^#\s+-{64}$", prev_line) or re.match(r"^#\s+-{64}$", next_line)) and line.startswith("# "):
                title = line[2:]
                if len(title) > 64:
                    print(f"❌ {f}:L{idx}: Título de cabeçalho vazou 64 hífens ({len(title)} cols): {title}")
                    failed = True
if failed:
    sys.exit(1)
' ${_staged_sh}
	fi
fi

### --------------------------------
### Markdown Prettier Validation
### --------------------------------
if command -v prettier > "/dev/null" 2>&1; then
	echo "  ↳ Validating staged Markdown files with Prettier..."
	_unformatted_md=""
	for _md_file in $(git diff --cached --name-only --diff-filter=d | grep '\.md$' || true); do
		if [ -f "${_md_file}" ] && ! prettier --check "${_md_file}" > "/dev/null" 2>&1; then
			_unformatted_md="${_unformatted_md} ${_md_file}"
		fi
	done
	if [ -n "${_unformatted_md}" ]; then
		echo "❌ [pre-commit] Unformatted Markdown files detected:${_unformatted_md}" >&2
		echo "   Run 'prettier --write <file>' or 'make format' from workspace root." >&2
		exit 1
	fi
fi

### --------------------------------
### Startup Latency Benchmark
### --------------------------------
_target_limit=64
_ultra_limit=32
_max_limit=128

case "$(uname -s 2> "/dev/null" || echo "unknown")" in
	MINGW*|CYGWIN*|MSYS*|Windows*)
		_target_limit=256; _ultra_limit=128; _max_limit=512 ;;
	Darwin*)
		_target_limit=128; _ultra_limit=64; _max_limit=256 ;;
esac

echo "  ↳ Benchmarking startup latency (target <${_target_limit}ms, max ${_max_limit}ms)..."
_boot_ms=$(bash -c '
	_s=$(python3 -c "import time; print(int(time.time()*1e9))" 2> "/dev/null" || date +%s%N)
	. ./library/detect.sh > "/dev/null" 2>&1
	. ./library/functions.sh > "/dev/null" 2>&1
	. ./core/environment.sh > "/dev/null" 2>&1
	_e=$(python3 -c "import time; print(int(time.time()*1e9))" 2> "/dev/null" || date +%s%N)
	echo $(( (_e - _s) / 1000000 ))
' 2> "/dev/null" || echo "0")

if [ "${_boot_ms:-0}" -lt "${_ultra_limit}" ]; then
	echo "     ⚡ Boot latency: ${_boot_ms}ms (ULTRA)"
elif [ "${_boot_ms:-0}" -lt "${_target_limit}" ]; then
	echo "     ✅ Boot latency: ${_boot_ms}ms (PASS)"
elif [ "${_boot_ms:-0}" -le "${_max_limit}" ]; then
	echo "     ⚠️  Boot latency: ${_boot_ms}ms (WARN)"
else
	echo "❌ [pre-commit] Boot latency ${_boot_ms}ms exceeded tolerance limit of ${_max_limit}ms (2^n)!" >&2
	exit 1
fi

echo "✅ [pre-commit] All quality gates passed cleanly!"
exit 0
